C4Container
    title Marketplace — C4 Container diagram

    Person(buyer, "Покупатель", "Просматривает ленту и оформляет заказы")
    Person(seller, "Продавец", "Управляет собственным ассортиментом")

    System_Ext(payment_provider, "Платёжный провайдер", "Проводит внешние платежи")
    System_Ext(notification_provider, "Провайдер уведомлений", "Доставляет email, SMS и push")

    System_Boundary(marketplace, "Marketplace") {
        Container(api_gateway, "API Gateway", "Reverse proxy", "Единая точка входа, маршрутизация и общие политики доступа")

        Container(user_service, "User Service", "Service / HTTP API", "Профили покупателей и продавцов, роли и контакты")
        ContainerDb(user_db, "User DB", "Relational database", "Профили, роли и контактные данные")

        Container(catalog_service, "Catalog Service", "Go / HTTP API", "Товары, категории, цены предложения и принадлежность продавцу")
        ContainerDb(catalog_db, "Catalog DB", "Relational database", "Товары, категории и предложения")

        Container(feed_service, "Feed Service", "Service / HTTP API", "Персонализирует и выдаёт ленту товаров")
        ContainerDb(feed_db, "Feed DB", "Search/index store", "Признаки интересов, индекс и рассчитанные рекомендации")

        Container(order_service, "Order Service", "Service / HTTP API", "Оформляет заказы и управляет их статусами")
        ContainerDb(order_db, "Order DB", "Relational database", "Заказы, позиции, снимки цен и история статусов")

        Container(payment_service, "Payment Service", "Service / HTTP API", "Учитывает платежи и изолирует платёжную интеграцию")
        ContainerDb(payment_db, "Payment DB", "Relational database", "Платёжные операции, суммы и статусы")

        Container(notification_service, "Notification Service", "Event consumer", "Отправляет уведомления о заказах и платежах")
        ContainerDb(notification_db, "Notification DB", "Relational database", "Шаблоны и журнал попыток доставки")

        Container(message_broker, "Message Broker", "Event streaming", "Доставляет доменные события как минимум один раз")
    }

    Rel(buyer, api_gateway, "Просматривает ленту, управляет профилем и заказами", "HTTPS/JSON (sync)")
    Rel(seller, api_gateway, "Управляет профилем и каталогом", "HTTPS/JSON (sync)")

    Rel(api_gateway, user_service, "Маршрутизирует запросы пользователей", "HTTPS/JSON (sync)")
    Rel(api_gateway, catalog_service, "Маршрутизирует запросы каталога", "HTTPS/JSON (sync)")
    Rel(api_gateway, feed_service, "Запрашивает товарную ленту", "HTTPS/JSON (sync)")
    Rel(api_gateway, order_service, "Маршрутизирует команды заказов", "HTTPS/JSON (sync)")

    Rel(user_service, user_db, "Читает и изменяет только свои данные", "Database protocol (sync)")
    Rel(catalog_service, catalog_db, "Читает и изменяет только свои данные", "Database protocol (sync)")
    Rel(feed_service, feed_db, "Читает и изменяет только свои данные", "Database protocol (sync)")
    Rel(order_service, order_db, "Читает и изменяет только свои данные", "Database protocol (sync)")
    Rel(payment_service, payment_db, "Читает и изменяет только свои данные", "Database protocol (sync)")
    Rel(notification_service, notification_db, "Читает и изменяет только свои данные", "Database protocol (sync)")

    Rel(order_service, catalog_service, "Проверяет актуальные данные товара", "HTTPS/JSON (sync)")
    Rel(order_service, payment_service, "Инициирует платёж", "HTTPS/JSON (sync)")
    Rel(notification_service, user_service, "Получает разрешённый канал связи", "HTTPS/JSON (sync)")

    Rel(catalog_service, message_broker, "Публикует изменения товаров", "Domain events (async)")
    Rel(user_service, message_broker, "Публикует изменения профиля", "Domain events (async)")
    Rel(order_service, message_broker, "Публикует изменения заказов", "Domain events (async)")
    Rel(payment_service, message_broker, "Публикует результаты платежей", "Domain events (async)")
    Rel(message_broker, feed_service, "Доставляет изменения каталога и пользовательские сигналы", "Domain events (async)")
    Rel(message_broker, order_service, "Доставляет результаты платежей", "Domain events (async)")
    Rel(message_broker, notification_service, "Доставляет события заказов и платежей", "Domain events (async)")

    Rel(payment_service, payment_provider, "Создаёт платёж", "HTTPS/JSON (sync)")
    Rel(payment_provider, payment_service, "Сообщает итоговый статус", "HTTPS webhook (async)")
    Rel(notification_service, notification_provider, "Передаёт сообщение для доставки", "HTTPS/JSON (sync)")

